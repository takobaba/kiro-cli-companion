{
    "name": "kiro-cli-companion",
    "displayName": "Kiro CLI Companion",
    "description": "Unofficial companion for the Kiro CLI: chat beside your code, plan features with specs, manage rules, and see what Kiro uses. Requires kiro-cli from kiro.dev.",
    "version": "0.1.0",
    "publisher": "takobaba",
    "author": "Takobaba",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/takobaba/kiro-cli-companion"
    },
    "homepage": "https://github.com/takobaba/kiro-cli-companion#readme",
    "bugs": {
        "url": "https://github.com/takobaba/kiro-cli-companion/issues"
    },
    "icon": "resources/icon.png",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "AI",
        "Chat",
        "Programming Languages"
    ],
    "keywords": [
        "ai",
        "kiro",
        "agent",
        "chat",
        "copilot",
        "code generation",
        "spec workflow"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "kiro.openChat",
                "title": "Kiro: Open Chat"
            },
            {
                "command": "kiro.startSpec",
                "title": "Kiro: Plan a Feature (Spec)"
            },
            {
                "command": "kiro.restartCli",
                "title": "Kiro: Restart CLI"
            },
            {
                "command": "kiro.login",
                "title": "Kiro: Login"
            },
            {
                "command": "kiro.selectWorkingDirectory",
                "title": "Kiro: Select Working Directory"
            },
            {
                "command": "kiro.setApiKey",
                "title": "Kiro: Set API Key"
            },
            {
                "command": "kiro.clearApiKey",
                "title": "Kiro: Clear API Key"
            },
            {
                "command": "kiro.newRule",
                "title": "Kiro: New Rule",
                "icon": "$(add)"
            },
            {
                "command": "kiro.openRulesFolder",
                "title": "Kiro: Open Rules Folder",
                "icon": "$(folder-opened)"
            },
            {
                "command": "kiro.refreshOverview",
                "title": "Kiro: Refresh",
                "icon": "$(refresh)"
            }
        ],
        "configuration": {
            "title": "Kiro",
            "properties": {
                "kiro.cliPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "Full path to the `kiro-cli` executable (or the directory containing it). Leave empty to auto-detect from `KIRO_CLI_PATH`, `PATH`, the Windows user/system PATH, and common install locations such as `%LOCALAPPDATA%\\Kiro-Cli\\kiro-cli.exe` or `~/.local/bin/kiro-cli`."
                },
                "kiro.workingDirectory": {
                    "type": "string",
                    "default": "",
                    "scope": "resource",
                    "markdownDescription": "Directory `kiro-cli` starts in. Supports `${workspaceFolder}`, `${workspaceFolder:<name>}`, `${workspaceFileDir}` (folder of the `.code-workspace` file), `${userHome}`, `~` and paths relative to the workspace. Leave empty to use the single workspace folder, or to be asked once in a multi-root workspace (change later with **Kiro: Select Working Directory**)."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "kiro",
                    "title": "Kiro CLI Companion",
                    "icon": "resources/activitybar.svg"
                }
            ]
        },
        "views": {
            "kiro": [
                {
                    "id": "kiro.launcher",
                    "name": "Kiro CLI Companion",
                    "icon": "resources/activitybar.svg"
                },
                {
                    "id": "kiro.overview",
                    "name": "What Kiro Uses",
                    "icon": "resources/activitybar.svg"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "kiro.launcher",
                "contents": "Chat with the Kiro CLI in a panel beside your code.\n[Open Chat](command:kiro.openChat)\nPlan a feature before coding: Kiro writes the requirements, a design and a task list, and you review each step.\n[Plan a Feature (Spec)](command:kiro.startSpec)\nRules tell Kiro your conventions (coding style, testing, …). See them under \"What Kiro Uses\" below.\n[New Rule](command:kiro.newRule)\n[Open Rules Folder](command:kiro.openRulesFolder)\nChoose the folder kiro-cli runs in, or restart it if it stops responding.\n[Select Working Directory](command:kiro.selectWorkingDirectory)\n[Restart CLI](command:kiro.restartCli)\nNot signed in? [Log in](command:kiro.login) or [use an API key](command:kiro.setApiKey)."
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "kiro.newRule",
                    "when": "view == kiro.overview",
                    "group": "navigation@1"
                },
                {
                    "command": "kiro.openRulesFolder",
                    "when": "view == kiro.overview",
                    "group": "navigation@2"
                },
                {
                    "command": "kiro.refreshOverview",
                    "when": "view == kiro.overview",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "kiro.newRule",
                    "when": "view == kiro.overview && viewItem == kiroGroup.rules",
                    "group": "inline@1"
                },
                {
                    "command": "kiro.openRulesFolder",
                    "when": "view == kiro.overview && viewItem == kiroGroup.rules",
                    "group": "inline@2"
                },
                {
                    "command": "kiro.startSpec",
                    "when": "view == kiro.overview && viewItem == kiroGroup.specs",
                    "group": "inline"
                }
            ],
            "commandPalette": [
                {
                    "command": "kiro.refreshOverview",
                    "when": "false"
                }
            ],
            "editor/title": [
                {
                    "command": "kiro.openChat",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/sinon": "^17.0.3",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^8.31.0",
        "@typescript-eslint/parser": "^8.31.0",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.5.2",
        "copy-webpack-plugin": "^12.0.2",
        "eslint": "^9.25.0",
        "fast-check": "^3.23.2",
        "sinon": "^19.0.2",
        "ts-loader": "^9.5.2",
        "typescript": "^5.8.3",
        "webpack": "^5.99.5",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "ignore": "^7.0.5"
    }
}